# ==============================================================================
# Auditing Mechanism in Cloud Data Services - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN REAL VALUES BEFORE RUNNING.
# All secret keys MUST be cryptographically random and AT LEAST 32 characters long.
# The application will refuse to start if secrets are missing, too short, or default values.

# Cryptographic HMAC Version Chain Secret (CRITICAL: NEVER expose, NEVER commit)
CHAIN_SECRET=replace_with_at_least_32_random_characters_secret_for_chain

# Session & Token Secret (CRITICAL: Used for authentication cookies and tokens)
JWT_SECRET=replace_with_at_least_32_random_characters_secret_for_jwt

# Tamper-Evident System Audit Log Secret (CRITICAL: Used for HMAC audit log verification)
LOG_SECRET=replace_with_at_least_32_random_characters_secret_for_log

# Cryptographic Block Tag Secret (K_TAG)
K_TAG=replace_with_at_least_32_random_characters_secret_for_tags

# Automated Auditor Service Token (CRITICAL: Used for internal service RPC)
AUDITOR_SERVICE_TOKEN=replace_with_at_least_32_random_characters_service_token

# Demo Mode (CRITICAL: Set to false in production; set to true ONLY for demonstration)
DEMO_MODE=false

# Policy Engine Automation Settings
AUTO_APPROVE=false
ALLOWED_EMAIL_DOMAINS=example.com,university.edu
RETENTION_DAYS=30

# Network and Server Configuration
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000
MAX_UPLOAD_MB=25

# Optional SMTP Configuration (leave empty to use Console Dev Mailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cloud-auditing.local

